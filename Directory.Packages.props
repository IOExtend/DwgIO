<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time only. -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.404" />
  </ItemGroup>

  <ItemGroup>
    <!-- Neutral scene model, referenced by DwgIO.Scene with a range whose upper bound is a prerelease.
         IOScene.Formats (GLB and OBJ writers) ships as a preview and needs IOScene 0.1.1 or later. -->
    <PackageVersion Include="IOScene" Version="[0.1.2, 0.2.0-0.0)" />
    <PackageVersion Include="IOScene.Formats" Version="[0.1.0-preview.1]" />
    <!-- Standalone WebGL HTML viewer generator; accepts IOScene scene documents directly. -->
    <PackageVersion Include="IOViewer" Version="[0.3.1]" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only packages, pinned to exact versions (no floating ranges). -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
