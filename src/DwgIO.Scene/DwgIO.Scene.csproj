<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Preserves the DwgIO scene API and writes DWG drawings as OBJ, GLB, SVG and standalone HTML.</Description>
    <PackageTags>dwg;autocad;cad;ioscene;export</PackageTags>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <PinProjectReferencesExactly>true</PinProjectReferencesExactly>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildNativeCoreOnly)' == 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DwgIO\DwgIO.csproj" />
    <ProjectReference Include="..\DwgIO.Scene.Adapter\DwgIO.Scene.Adapter.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(BuildNativeCoreOnly)' == 'true'">
    <Compile Remove="Compatibility/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(BuildNativeCoreOnly)' != 'true'">
    <PackageReference Include="IOScene.Formats" />
    <PackageReference Include="IOViewer" />
    <Compile Include="..\Shared\AtomicOutput.cs;..\Shared\ArcAngles.cs;..\Shared\DwgAciPalette.cs"
             Link="Compatibility\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The shared pack metadata expects icon.png beside the project; the adapter ships the engine's icon. -->
  <ItemGroup>
    <None Remove="$(MSBuildProjectDirectory)/icon.png" />
    <None Include="..\DwgIO\icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
