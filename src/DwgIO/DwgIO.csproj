<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>DwgIO</PackageId>
    <Description>Reads Autodesk DWG drawings (.dwg) without AutoCAD and exposes sections, metadata and entities.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildNativeCoreOnly)' == 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(BuildNativeCoreOnly)' == 'true'">
    <Compile Remove="Compatibility/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(BuildNativeCoreOnly)' != 'true'">
    <Compile Include="..\Shared\AtomicOutput.cs" Link="Compatibility\AtomicOutput.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DwgIO.Tests" />
  </ItemGroup>

</Project>
